# Email alerts (Resend)
RESEND_API_KEY=your_resend_api_key_here
ALERT_EMAIL_TO=info@facilityh2o.com
ALERT_EMAIL_FROM=alerts@facilityh2o.com

# SMS alerts (Twilio) — optional, leave blank to disable SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# App config
NEXT_PUBLIC_APP_URL=https://facilityh2o.com
SESSION_SECRET=your_random_secret_here_min_32_chars
CRON_SECRET=facilityh2o_cron_2026
