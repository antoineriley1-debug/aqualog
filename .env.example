# ════════════════════════════════════════════════════════════════════════════════
# FacilityH2O Environment Configuration
# Author: Antoine W. Riley Sr.
# © 2026 FacilityH2O Inc. All Rights Reserved.
# ════════════════════════════════════════════════════════════════════════════════
#
# SECURITY WARNING:
# 1. Never commit .env files to git (use .env.local for local development)
# 2. Never commit secrets or API keys
# 3. Use GitHub Secrets for CI/CD (GitHub Actions)
# 4. Use Vercel Environment Variables for deployment
# 5. Rotate secrets regularly
# 6. Use unique values per environment (dev/staging/prod)
#
# ════════════════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────────────────
# DATABASE (Supabase)
# ────────────────────────────────────────────────────────────────────────────────

# Supabase URL (public, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (public, for frontend auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key (PRIVATE - backend only, never expose to frontend)
# Store this ONLY in server-side environment variables or GitHub Secrets
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ────────────────────────────────────────────────────────────────────────────────
# EMAIL ALERTS (Resend)
# ────────────────────────────────────────────────────────────────────────────────

# Resend API key (PRIVATE - backend only)
RESEND_API_KEY=your_resend_api_key_here

# Email configuration
ALERT_EMAIL_TO=info@facilityh2o.com
ALERT_EMAIL_FROM=alerts@facilityh2o.com

# ────────────────────────────────────────────────────────────────────────────────
# SMS ALERTS (Twilio) — Optional
# ────────────────────────────────────────────────────────────────────────────────

# Leave blank to disable SMS alerts
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ────────────────────────────────────────────────────────────────────────────────
# SESSION & SECURITY
# ────────────────────────────────────────────────────────────────────────────────

# Session secret (PRIVATE - 32+ random characters)
# Generate: openssl rand -hex 32
SESSION_SECRET=your_random_secret_here_min_32_chars

# CSRF token expiration (seconds)
CSRF_TOKEN_EXPIRY=3600

# Session duration (seconds, default 8 hours)
SESSION_DURATION=28800

# ────────────────────────────────────────────────────────────────────────────────
# APP CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────────

# App URL (public, safe to expose)
NEXT_PUBLIC_APP_URL=https://facilityh2o.com

# Node environment
NODE_ENV=development

# Debug mode (set to false in production)
DEBUG=false

# ────────────────────────────────────────────────────────────────────────────────
# CRON & SCHEDULED JOBS
# ────────────────────────────────────────────────────────────────────────────────

# Cron secret for triggering scheduled jobs (PRIVATE)
# Should match the secret sent by your cron provider (EasyCron, AWS EventBridge, etc)
CRON_SECRET=your_cron_secret_here_min_32_chars

# ────────────────────────────────────────────────────────────────────────────────
# STRIPE (Optional, for billing)
# ────────────────────────────────────────────────────────────────────────────────

# Stripe public key (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxx

# Stripe secret key (PRIVATE - backend only)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx

# Webhook signing secret (PRIVATE - backend only)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# ────────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ────────────────────────────────────────────────────────────────────────────────

# Rate limit: Auth endpoints (requests per 15 minutes)
RATE_LIMIT_AUTH=5

# Rate limit: API endpoints (requests per minute)
RATE_LIMIT_API=100

# Rate limit: Upload endpoints (requests per minute)
RATE_LIMIT_UPLOAD=20

# ────────────────────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ────────────────────────────────────────────────────────────────────────────────

# Enable request logging (for debugging)
LOG_REQUESTS=false

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ════════════════════════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ════════════════════════════════════════════════════════════════════════════════
#
# 1. Copy this file to .env.local (for local development)
# 2. NEVER commit .env.local or .env to git
# 3. Fill in your actual values from:
#    - Supabase dashboard (Database settings)
#    - Resend dashboard (API keys)
#    - Twilio dashboard (if using SMS)
#    - Stripe dashboard (if using billing)
#    - EasyCron / AWS EventBridge (for CRON_SECRET)
# 4. For production:
#    - Use Vercel Environment Variables (Settings > Environment Variables)
#    - Use GitHub Secrets (for CI/CD pipelines)
#    - Rotate secrets regularly
#    - Use separate secrets per environment (dev/staging/prod)
#
# ════════════════════════════════════════════════════════════════════════════════
# SECURITY CHECKLIST
# ════════════════════════════════════════════════════════════════════════════════
#
# Before deploying to production:
# ✅ Generate unique SESSION_SECRET (openssl rand -hex 32)
# ✅ Rotate all API keys (Resend, Stripe, Twilio, Supabase)
# ✅ Use separate Supabase project for production
# ✅ Enable RLS (Row Level Security) on all tables
# ✅ Set NODE_ENV=production
# ✅ Disable DEBUG mode
# ✅ Set all secrets in Vercel Environment Variables (not in code)
# ✅ Run pre-deploy validation: node scripts/pre-deploy-check.js
# ✅ Test rate limiting
# ✅ Test CSRF protection
# ✅ Test error handling (no verbose errors in production)
#
# ════════════════════════════════════════════════════════════════════════════════

